# Copy to .env and fill in as needed.

# LLM routing metadata consumed by llm_client.py
LLM_PROVIDER=openai
LLM_MODEL=gpt-5.4
LLM_ENABLE_REAL_CALLS=false
LLM_TIMEOUT_SECONDS=25
LLM_RETRIES=2
OPENAI_API_BASE=https://api.openai.com/v1

# Optional keys for future real LLM integrations
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
